[Unit]
Description=Apache Storm UI
Requires=storm-nimbus.service
After=storm-nimbus.service

[Service]
Type=simple
User=vagrant
Environment=JAVA_HOME=/usr/local/java
Environment=STORM_HOME=/usr/local/storm
ExecStart=/usr/local/storm/bin/storm ui
Restart=on-failure
RestartSec=5
SuccessExitStatus=143

[Install]
WantedBy=multi-user.target
