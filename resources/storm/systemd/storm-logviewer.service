[Unit]
Description=Apache Storm LogViewer
Requires=storm-supervisor.service
After=network-online.target storm-supervisor.service

[Service]
Type=simple
User=vagrant
Environment=JAVA_HOME=/usr/local/java
Environment=STORM_HOME=/usr/local/storm
Environment=STORM_CONF_DIR=/usr/local/storm/conf
Environment=PATH=/usr/local/java/bin:/usr/local/storm/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
ExecStart=/usr/local/storm/bin/storm logviewer
ExecStartPost=/bin/bash -c 'for i in {1..90}; do if (: > /dev/tcp/127.0.0.1/8000) 2>/dev/null; then exit 0; fi; sleep 1; done; exit 1'
Restart=on-failure
RestartSec=5
SuccessExitStatus=143
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
