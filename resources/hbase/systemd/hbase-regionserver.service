[Unit]
Description=Apache HBase RegionServer
Requires=hbase-master.service
After=hbase-master.service

[Service]
Type=simple
User=vagrant
Environment=JAVA_HOME=/usr/local/java
Environment=HADOOP_HOME=/usr/local/hadoop
Environment=HADOOP_CONF_DIR=/usr/local/hadoop/etc/hadoop
Environment=HBASE_HOME=/usr/local/hbase
ExecStart=/usr/local/hbase/bin/hbase regionserver start
Restart=on-failure
RestartSec=10
SuccessExitStatus=143

[Install]
WantedBy=multi-user.target
